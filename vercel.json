{
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "test.menunova.me" }
      ],
      "destination": "/test/index.html"
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "(?<slug>[^.]+)\\.menunova\\.me" }
      ],
      "destination": "/menu/index.html"
    },
    {
      "source": "/admin/customers/:path*",
      "has": [
        { "type": "host", "value": "(?<slug>[^.]+)\\.menunova\\.me" }
      ],
      "destination": "/admin/customers/index.html"
    },
    {
      "source": "/admin/:path*",
      "has": [
        { "type": "host", "value": "(?<slug>[^.]+)\\.menunova\\.me" }
      ],
      "destination": "/admin/index.html"
    },
    {
      "source": "/kitchen/:path*",
      "has": [
        { "type": "host", "value": "(?<slug>[^.]+)\\.menunova\\.me" }
      ],
      "destination": "/kitchen/index.html"
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "menunova.me" }
      ],
      "destination": "/landing/index.html"
    },
    {
      "source": "/demo/:path*",
      "has": [
        { "type": "host", "value": "menunova.me" }
      ],
      "destination": "/demo/:path*"
    },
    {
      "source": "/:path(.*)",
      "has": [
        { "type": "host", "value": "menunova.me" }
      ],
      "destination": "/landing/:path"
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        { "type": "host", "value": "www.menunova.me" }
      ],
      "destination": "https://menunova.me/:path",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/restaurants/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/landing/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/(js|css|shared)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}